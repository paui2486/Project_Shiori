# Google API 設置
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
GROQ_API_KEY=your_groq_api_key_here
NVAPI_KEY=your_nvapi_key_here
BRAVESEARCH_KEY=your_bravesearch_key_here
openroute_KEY=your_openroute_key_here

# HuggingFace 模型快取目錄 (可選，避免重複下載 BGE-M3 模型)
# HF_HOME=/app/data/hf_cache

# 程式碼路徑配置 (對應 Docker 內的掛載點)
DB_PATH=/app/data/db/light_novel_offline.db
CHROMA_PATH=/app/data/chroma/ln_bge_index
